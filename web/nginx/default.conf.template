# nginx нового интерфейса dcm4chee.
# ${ARCHIVE_URL} подставляется при старте контейнера (envsubst образа nginx).

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/wasm
               image/svg+xml application/dicom+json;

    # Проверка живости для docker/systemd — без обращения к архиву.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Ассеты с хешем в имени не меняются никогда — кэшируем навсегда.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # REST и DICOMweb архива. Путь сохраняется: /dcm4chee-arc/... → ${ARCHIVE_URL}/dcm4chee-arc/...
    location /dcm4chee-arc/ {
        proxy_pass ${ARCHIVE_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Большие серии: загрузка через STOW без лимита, ответы WADO — потоком, длинные таймауты.
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Всё остальное — маршруты SPA. index.html не кэшируем: в нём ссылки на свежие ассеты.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
