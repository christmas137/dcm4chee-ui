# Настройки развёртывания dcm4chee с новым интерфейсом.
# install.sh создаёт .env из этого файла сам: подставляет адрес сервера и случайные пароли.
# Править руками можно, но после первого запуска пароли LDAP и базы менять только вместе
# с данными — они записываются при инициализации.

# --- Версии (проверенная связка из официального compose dcm4chee) ----------------------
ARC_VERSION=5.35.2
LDAP_VERSION=2.6.15-35.2
POSTGRES_VERSION=17.9-35
UI_VERSION=latest

# --- Сервер ----------------------------------------------------------------------------
# Адрес, по которому сервер видят модальности и другие узлы. Попадает в конфигурацию
# соединений архива и в список AE в интерфейсе.
ARCHIVE_HOST=__ARCHIVE_HOST__
# Где лежат все данные: база, конфигурация LDAP, снимки. Должно быть много места.
DATA_DIR=/var/lib/dcm4chee

# --- Порты на хосте --------------------------------------------------------------------
# Новый интерфейс
UI_PORT=80
# REST/DICOMweb архива и штатный интерфейс (/dcm4chee-arc/ui2)
ARCHIVE_HTTP_PORT=8080
# Приём и выдача по DICOM (C-STORE, C-FIND, C-MOVE)
DICOM_PORT=11112
HL7_PORT=2575
# Консоль WildFly — открыта только на 127.0.0.1
MANAGEMENT_PORT=9990

# --- Память архива ---------------------------------------------------------------------
JVM_HEAP_MIN=512m
JVM_HEAP_MAX=2g

# --- Учётные данные (генерируются install.sh) -------------------------------------------
LDAP_ROOTPASS=__GENERATED__
LDAP_CONFIGPASS=__GENERATED__
POSTGRES_DB=pacsdb
POSTGRES_USER=pacs
POSTGRES_PASSWORD=__GENERATED__
WILDFLY_ADMIN_USER=admin
WILDFLY_ADMIN_PASSWORD=__GENERATED__

# --- Режим «только интерфейс» (install.sh --ui-only) ------------------------------------
# Адрес уже работающего dcm4chee, без пути: http://pacs.local:8080
ARCHIVE_URL=http://arc:8080
